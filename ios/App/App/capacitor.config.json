{
	"appId": "com.adam.driver",
	"appName": "Adam Passenger",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"android": {
		"webContentsDebuggingEnabled": false,
		"allowMixedContent": false,
		"captureInput": true,
		"backgroundColor": "#0f172a"
	},
	"ios": {
		"webContentsDebuggingEnabled": false,
		"contentInset": "always",
		"backgroundColor": "#0f172a"
	},
	"plugins": {
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon_config_sample",
			"iconColor": "#4f46e5",
			"sound": "beep.wav"
		},
		"Geolocation": {
			"enableHighAccuracy": true,
			"timeout": 10000,
			"maximumAge": 0
		},
		"Camera": {
			"presentationStyle": "fullscreen",
			"saveToGallery": false
		}
	},
	"cordova": {},
	"packageClassList": []
}
